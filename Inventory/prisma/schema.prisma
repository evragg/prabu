generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id           String     @id @default(cuid())
  category     String
  serialNumber String     @unique
  name         String
  location     String
  rack         String
  status       String     @default("available") // "available" or "checked_out"
  quantity     Int        @default(1)            // Stock count for this item
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  logs         LogEntry[]
}

model LogEntry {
  id           String   @id @default(cuid())
  itemId       String?
  serialNumber String
  itemName     String
  action       String   // "checkout" or "return"
  person       String
  location     String
  quantity     Int      @default(1)  // How many were taken/returned in this transaction
  timestamp    DateTime @default(now())
  item         Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
}
