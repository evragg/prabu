generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id           String     @id @default(cuid())
  category     String
  serialNumber String     @unique
  name         String
  location     String
  rack         String
  status       String     @default("available") // "available" or "checked_out"
  quantity     Int        @default(1)            // Stock count for this item
  minStock     Int        @default(3)            // Threshold alert stok rendah
  imageUrl     String?                           // URL foto fisik barang (opsional)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  logs         LogEntry[]
}

model LogEntry {
  id           String   @id @default(cuid())
  itemId       String?
  serialNumber String
  itemName     String
  action       String   // "checkout", "return", "in", "create", "update", "delete"
  person       String
  location     String
  quantity     Int      @default(1)  // How many were taken/returned in this transaction
  timestamp    DateTime @default(now())
  item         Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  password  String   // SHA-256 password hash
  role      String   @default("viewer") // "admin" or "viewer"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id          String     @id @default(cuid())
  name        String     @unique // e.g. "Unit 9717"
  plateNumber String?    // e.g. "B 9717 SLB"
  vehicleType String?    // e.g. "Toyota Hilux 4x4"
  driver      String?    // e.g. "Crew Field / Driver"
  status      String     @default("active") // "active", "standby", "maintenance"
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       UnitItem[]
}

model UnitItem {
  id           String   @id @default(cuid())
  unitId       String
  serialNumber String
  name         String
  category     String   @default("Umum")
  compartment  String?  @default("")
  quantity     Int      @default(1)
  unitType     String?  @default("Pcs")
  minStock     Int      @default(1)
  condition    String?  @default("Good")
  status       String   @default("available")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
}
